# ============================================================
# Backend environment configuration
# Copy this file to `.env` and fill in the real values.
# NEVER commit the real `.env` file to version control.
# ============================================================

# Port the backend runs on (the Vite dev proxy targets this).
PORT=3001

# The Gmail inbox that receives contact-form messages.
CONTACT_TO_EMAIL=ka6246770@gmail.com

# -- Gmail SMTP (Nodemailer) --
# You must create a Google "App Password":
#   1. Enable 2-Step Verification on your Google account
#   2. Google Account > Security > App passwords
#   3. Generate a password for "Mail" (16 characters, no spaces)
#
# SMTP_USER is your full Gmail address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ka6246770@gmail.com
SMTP_PASS=iuvjdxpdwgfreygo
